# Jeton du bot Telegram, obtenu via @BotFather
TELEGRAM_TOKEN=votre_token_ici
# Identifiant de la conversation/chat de destination
TELEGRAM_CHAT_ID=votre_chat_id_ici
# Dossier surveillé (optionnel, défaut : ./VersMonTel)
WATCH_DIRECTORY=./VersMonTel
# Dossier où arrivent les fichiers envoyés depuis le téléphone (optionnel, défaut : ./DepuisMonTel)
INBOX_DIRECTORY=./DepuisMonTel
